import { Button, ListView, TextEdit } from "std-widgets.slint";

export struct MessageRow {
    subject: string,
    sender: string,
    date: string,
    unread: bool,
}

export component AppWindow inherits Window {
    title: "Siskin S3 probe";
    width: 1000px;
    height: 680px;
    background: #eef0f3;

    in property <[MessageRow]> messages;
    in-out property <length> scroll-y;
    in-out property <bool> reading-open;
    in property <string> status-text: "ready";
    in property <bool> benchmark-running;

    out property <length> pane-x: pane.absolute-position.x;
    out property <length> pane-y: pane.absolute-position.y;
    out property <length> pane-width: pane.width;
    out property <length> pane-height: pane.height;

    callback read-requested(int);
    callback close-reading();
    callback start-benchmark();

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        Rectangle {
            height: 48px;
            background: #ffffff;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                Text {
                    text: "Siskin · Windows S3";
                    font-size: 16px;
                    vertical-alignment: center;
                }

                TextEdit {
                    width: 180px;
                    height: 30px;
                    font-size: 13px;
                    wrap: no-wrap;
                    placeholder-text: "输入法测试";
                }

                Rectangle { horizontal-stretch: 1; }

                Button {
                    text: "打开正文";
                    enabled: !root.reading-open;
                    clicked => { root.read-requested(0); }
                }

                Button {
                    text: "关闭正文";
                    enabled: root.reading-open;
                    clicked => { root.close-reading(); }
                }

                Button {
                    text: root.benchmark-running ? "测试中…" : "滚动基准";
                    enabled: !root.benchmark-running;
                    clicked => { root.start-benchmark(); }
                }
            }
        }

        HorizontalLayout {
            spacing: 1px;

            ListView {
                width: 420px;
                content-y <=> root.scroll-y;

                for message[i] in root.messages : Rectangle {
                    height: 64px;
                    background: Math.mod(i, 2) == 0 ? #ffffff : #f7f8fa;

                    HorizontalLayout {
                        padding: 8px;
                        spacing: 6px;

                        VerticalLayout {
                            spacing: 2px;

                            Text {
                                text: message.sender;
                                font-size: 12px;
                                color: #6b7280;
                                overflow: elide;
                            }

                            Text {
                                text: message.subject;
                                font-size: 14px;
                                color: message.unread ? #111827 : #9ca3af;
                                overflow: elide;
                            }
                        }

                        Text {
                            text: message.date;
                            font-size: 11px;
                            color: #9ca3af;
                            vertical-alignment: top;
                        }
                    }
                }
            }

            pane := Rectangle {
                horizontal-stretch: 1;
                background: #ffffff;

                if !root.reading-open : Text {
                    text: "本地 HTML 正文由 WebView2 覆盖此区域";
                    font-size: 13px;
                    color: #9ca3af;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            height: 26px;
            background: #e5e7eb;

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;

                Text {
                    text: root.status-text;
                    font-size: 12px;
                    color: #374151;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
